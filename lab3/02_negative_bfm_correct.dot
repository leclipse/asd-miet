digraph G {
  graph [label="BFM: correct distances with negative edge", labelloc=t, fontsize=18];
  rankdir=LR;
  node [shape=circle];
  0 [label="0 (0)"];
  1 [label="1 (1)"];
  2 [label="2 (5)"];
  3 [label="3 (3)"];
  4 [label="4 (4)"];
